{
  "appId": "com.engibuddy.app",
  "appName": "EngiBuddy",
  "webDir": "frontend",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": ["localhost:*", "*.render.com", "*.onrender.com"]
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystorePassword": null,
      "keystoreAlias": null,
      "keystoreAliasPassword": null
    }
  },
  "ios": {
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b1020",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
